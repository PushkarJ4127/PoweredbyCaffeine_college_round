# Copy to .env (a file named exactly ".env"). Never commit .env.
GEMINI_API_KEY=your-key-here

# TEAM SETTINGS: everyone uses the same values so results match when we merge.
AGENTBREAK_MODEL=gemini-3.1-flash-lite
AGENTBREAK_GULLIBLE=1
AGENTBREAK_TEMPERATURE=0

# Optional, only if calls are slow and your model supports it (delete the line if it errors):
# AGENTBREAK_THINKING_BUDGET=0
